# ============================================================
# ROOSTOO API CREDENTIALS
# ============================================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to GitHub!

# --- TESTING credentials (use during Oct 1-3 prep) ---
ROOSTOO_API_KEY=your_testing_api_key_here
ROOSTOO_SECRET_KEY=your_testing_secret_key_here

# --- COMPETITION credentials (use from Oct 4 onwards) ---
# ROOSTOO_API_KEY=your_competition_api_key_here
# ROOSTOO_SECRET_KEY=your_competition_secret_key_here

# ============================================================
# BOT CONFIGURATION
# ============================================================
# How often the bot checks market and trades (in seconds)
LOOP_INTERVAL_SECONDS=60

# Maximum % of portfolio to use per trade (0.0 to 1.0)
MAX_POSITION_SIZE=0.10

# Stop loss percentage (e.g., 0.02 = 2% below entry)
STOP_LOSS_PCT=0.02

# Global max drawdown before bot halts (e.g., 0.15 = 15%)
MAX_DRAWDOWN_PCT=0.15
